# Copy to .env and fill in your values.
# Never commit .env (it should stay in .gitignore).

# --- Required ---

# SEC EDGAR fair-access: real name + email, ASCII only (no smart quotes)
# Used for submissions, Form 4, 13F ingest, SEC filings tab
SEC_USER_AGENT=YourName your.email@example.com

# PostgreSQL connection string
# Local:  postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Supabase: Project Settings → Database → Connection string (URI)
# If password has @ # % etc., URL-encode it (e.g. @ → %40)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tradepile

# --- Recommended for bulk ingest (13F / Form 4) ---

# Per-query timeout in ms (default 120000). Raise for long ingest runs.
PG_STATEMENT_TIMEOUT_MS=300000

# --- Optional ---

# Dev server port (default 8787)
# PORT=8787

# Yahoo fundamentals mostly use yahoo-finance2; Alpha Vantage is optional fallback/extra
# https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Finnhub proxy routes in server.mjs (only if you use them)
# FINNHUB_API_KEY=

# Optional HTTP(S) proxy for politician scrapes (Senate eFD often blocks VPS/datacenter IPs)
# Example: http://user:pass@host:port   or   socks5://host:port (if supported by undici)
# POLITICIAN_HTTP_PROXY=

# Connection pool size (default 10)
# PG_POOL_MAX=10

# --- Auth (email/password sessions) ---

# Public site origin used in password-reset / email-verify links
# AUTH_PUBLIC_ORIGIN=http://localhost:8787

# Session lifetime in days (default 30)
# AUTH_SESSION_DAYS=30

# Set to 1 behind HTTPS in production (auto when NODE_ENV=production)
# AUTH_COOKIE_SECURE=1

# Require email verification before login (default ON). Set to 0 only for local demos.
# AUTH_REQUIRE_EMAIL_VERIFICATION=0

# Include reset/verify URLs in API JSON responses (default on when not production)
# AUTH_DEV_EXPOSE_TOKENS=1

# Resend transactional email (verify + password reset + contact form)
# https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# Verified domain sender (prefer noreply@… — do not use the same address as CONTACT_INBOX)
# AUTH_EMAIL_FROM=InvestAtlant <noreply@investatlant.com>
# Optional override for contact form From: (defaults to AUTH_EMAIL_FROM)
# CONTACT_EMAIL_FROM=InvestAtlant <noreply@investatlant.com>
# Inbox for /contact form submissions (Reply-To is the visitor's email)
# CONTACT_INBOX=contact@investatlant.com
#
# IONOS + Resend: keep MX on IONOS for receiving, and merge SPF on the apex domain:
#   v=spf1 include:_spf-eu.ionos.com include:amazonses.com ~all
# (Resend sends via Amazon SES; without that include, IONOS often drops/junks mail.)

# --- Stripe (Hosted Checkout for Premium) ---
# Test: https://dashboard.stripe.com/test/apikeys
# Live: https://dashboard.stripe.com/apikeys  (toggle "Test mode" OFF)
# Server-only — do NOT prefix with VITE_
# STRIPE_PUBLISHABLE_KEY=pk_test_...   # or pk_live_...
# STRIPE_SECRET_KEY=sk_test_...        # or sk_live_...
# Dashboard → Developers → Webhooks (endpoint: https://YOUR_DOMAIN/api/stripe/webhook)
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# STRIPE_WEBHOOK_SECRET=whsec_...      # required when using sk_live_...
# Recurring Premium Price ID (must match mode: test price with test keys, live with live)
# https://dashboard.stripe.com/prices
# STRIPE_PRICE_ID=price_...
# Public site origin used in Checkout success/cancel + Portal return URLs
# Must be https:// when using live keys
# DOMAIN=https://investatlant.com
