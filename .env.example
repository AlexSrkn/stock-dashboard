# Copy to .env and fill in your values.
# Never commit .env (it should stay in .gitignore).

# --- Required ---

# SEC EDGAR fair-access: real name + email, ASCII only (no smart quotes)
# Used for submissions, Form 4, 13F ingest, SEC filings tab
SEC_USER_AGENT=YourName your.email@example.com

# PostgreSQL connection string
# Local:  postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Supabase: Project Settings → Database → Connection string (URI)
# If password has @ # % etc., URL-encode it (e.g. @ → %40)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tradepile

# --- Recommended for bulk ingest (13F / Form 4) ---

# Per-query timeout in ms (default 120000). Raise for long ingest runs.
PG_STATEMENT_TIMEOUT_MS=300000

# --- Optional ---

# Dev server port (default 8787)
# PORT=8787

# Yahoo fundamentals mostly use yahoo-finance2; Alpha Vantage is optional fallback/extra
# https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Finnhub proxy routes in server.mjs (only if you use them)
# FINNHUB_API_KEY=

# Optional HTTP(S) proxy for politician scrapes (Senate eFD often blocks VPS/datacenter IPs)
# Example: http://user:pass@host:port   or   socks5://host:port (if supported by undici)
# POLITICIAN_HTTP_PROXY=

# Connection pool size (default 10)
# PG_POOL_MAX=10

# --- Auth (email/password sessions) ---

# Public site origin used in password-reset / email-verify links
# AUTH_PUBLIC_ORIGIN=http://localhost:8787

# Session lifetime in days (default 30)
# AUTH_SESSION_DAYS=30

# Set to 1 behind HTTPS in production (auto when NODE_ENV=production)
# AUTH_COOKIE_SECURE=1

# Require email verification before login (default ON). Set to 0 only for local demos.
# AUTH_REQUIRE_EMAIL_VERIFICATION=0

# Include reset/verify URLs in API JSON responses (default on when not production)
# AUTH_DEV_EXPOSE_TOKENS=1

# Resend transactional email (verify + password reset)
# https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# Use onboarding@resend.dev for first tests; switch to your verified domain later
# AUTH_EMAIL_FROM=InvestAtlant <onboarding@resend.dev>
